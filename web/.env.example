# Salin ke .env lalu sesuaikan.

# Lokasi file SQLite (relatif ke folder kerja saat run).
DATABASE_PATH=data/app.db

# Garam untuk hashing IP (anti-abuse). WAJIB diganti di produksi dengan string acak panjang.
# Kita menyimpan hash IP, BUKAN IP mentah — lihat ../docs/legal-liability.md (higiene PDP).
IP_SALT=ganti-dengan-string-acak-panjang
